{
  "name": "react-ace",
  "version": "11.0.0",
  "description": "A react component for Ace Editor",
  "type": "commonjs",
  "main": "lib/index.js",
  "module": "lib/index.mjs",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prettier": "prettier --write \"src/**\" \"example/*.js\" \"tests/**\"",
    "clean": "node -e \"for (const d of ['lib','dist']) fs.rmSync(d, { recursive: true, force: true })\"",
    "lint": "oxlint src/",
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "example": "vite --config vite.config.example.ts",
    "build:example": "vite build --config vite.config.example.ts",
    "check": "npm run lint && npm run typecheck",
    "preversion": "npm run clean && npm run check",
    "version": "npm run build",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest --coverage",
    "prepare": "npm run build"
  },
  "author": "James Hrisho",
  "license": "MIT",
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^22.5.5",
    "@types/prop-types": "^15.7.12",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "jsdom": "^30.1.2",
    "oxlint": "^1.6.0",
    "prettier": "^3.2.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "ace",
    "ace editor",
    "react-component",
    "react"
  ],
  "dependencies": {
    "ace-builds": "^1.36.3",
    "diff-match-patch": "^1.0.5",
    "fast-equals": "^5.3.3",
    "prop-types": "^15.8.1"
  },
  "peerDependencies": {
    "react": "^0.13.0 || ^0.14.0 || ^15.0.1 || ^16.0.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^0.13.0 || ^0.14.0 || ^15.0.1 || ^16.0.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "repository": {
    "type": "git",
    "url": "http://github.com/securingsincity/react-ace.git"
  },
  "prettier": {
    "singleQuote": false,
    "trailingComma": "none",
    "arrowParens": "avoid"
  }
}
